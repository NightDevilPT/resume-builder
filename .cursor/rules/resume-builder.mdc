```
api/
├── route.ts                    # Health check
├── auth/
│   └── signup/route.ts        # POST /api/auth/signup
└── template/
    ├── route.ts               # GET, POST /api/template
    └── [id]/route.ts          # GET, PUT, DELETE /api/template/:id
```

### API Response Format
**Interface:** `src/interfaces/api-response.interface.ts`

```typescript
export interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: {
    code: string;
    message: string;
    details?: unknown;
  };
  meta?: {
    currentPage: number;
    totalPages: number;
    totalItems: number;
    pageSize: number;
    hasNextPage: boolean;
    hasPreviousPage: boolean;
    nextPage: number;
    previousPage: number;
  };
}
```

### API Route Example
```typescript
// src/app/api/template/route.ts
import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/lib/services/prisma.service";
import { templateSchema } from "@/lib/validations/template.validations";

export async function GET(request: NextRequest) {
  try {
    const templates = await prisma.template.findMany({
      where: { isPublished: true, isActive: true },
    });

    return NextResponse.json({
      success: true,
      data: templates,
    });
  } catch (error) {
    return NextResponse.json(
      {
        success: false,
        error: {
          code: "FETCH_ERROR",
          message: "Failed to fetch templates",
        },
      },
      { status: 500 }
    );
  }
}

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    
    // Validate with Zod
    const validated = templateSchema.parse(body);
    
    const template = await prisma.template.create({
      data: validated,
    });

    return NextResponse.json(
      {
        success: true,
        data: template,
      },
      { status: 201 }
    );
  } catch (error) {
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: "VALIDATION_ERROR",
            message: "Invalid request data",
            details: error.errors,
          },
        },
        { status: 400 }
      );
    }

    return NextResponse.json(
      {
        success: false,
        error: {
          code: "CREATE_ERROR",
          message: "Failed to create template",
        },
      },
      { status: 500 }
    );
  }
}
```

### API Client Usage
**Location:** `src/lib/services/api-client.service.ts`

```typescript
import { apiClient } from "@/lib/services/api-client.service";
import { API_URLS } from "@/constants/api-urls";

// GET request
const response = await apiClient.get<TemplateConfig>(
  `${API_URLS.TEMPLATE}/${id}`
);

// POST request
const response = await apiClient.post<TemplateConfig>(
  API_URLS.TEMPLATE,
  templateData
);

// Error handling
try {
  const response = await apiClient.get<TemplateConfig>("/api/template");
  console.log(response.data);
} catch (error) {
  if (error instanceof ApiError) {
    console.error(error.status, error.code, error.message);
  }
}
```

