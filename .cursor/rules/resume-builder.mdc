### React Optimization
```typescript
// ✅ Memoize expensive computations
const expensiveValue = useMemo(
  () => computeExpensiveValue(data),
  [data]
);

// ✅ Memoize callback functions
const handleClick = useCallback(
  () => handleAction(id),
  [id]
);

