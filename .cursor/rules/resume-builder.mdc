## 🚨 Common Pitfalls & Solutions

### 1. Client vs Server Components
```typescript
// ❌ Problem: Using hooks in server component
export default function Page() {
  const [state, setState] = useState(); // Error!
  return <div>{state}</div>;
}

// ✅ Solution: Add "use client" directive
"use client";
export default function Page() {
  const [state, setState] = useState(); // Works!
  return <div>{state}</div>;
}
```

### 2. Prisma Client Initialization
```typescript
// ❌ Problem: Multiple Prisma instances
import { PrismaClient } from "@prisma/client";
const prisma = new PrismaClient(); // Creates new instance each time

// ✅ Solution: Use singleton pattern
// lib/services/prisma.service.ts
import { PrismaClient } from "@prisma/client";

const globalForPrisma = global as unknown as { prisma: PrismaClient };

export const prisma =
  globalForPrisma.prisma ||
  new PrismaClient({
    log: process.env.NODE_ENV === "development" ? ["query"] : [],
  });

if (process.env.NODE_ENV !== "production") globalForPrisma.prisma = prisma;
```

### 3. Form Validation with Zod
```typescript
// ❌ Problem: Not handling validation errors
const data = schema.parse(input); // Throws error

// ✅ Solution: Use safeParse for error handling
const result = schema.safeParse(input);
if (!result.success) {
  console.error(result.error.errors);
  return;
}
const data = result.data;
```

### 4. React Hook Dependencies
```typescript
// ❌ Problem: Missing dependencies
useEffect(() => {
  fetchData(id);
}, []); // id should be in dependencies

// ✅ Solution: Include all dependencies
useEffect(() => {
  fetchData(id);
}, [id]);
```

### 5. Date Handling
```typescript
// ❌ Problem: Storing Date objects in JSON
const data = { date: new Date() }; // JSON.stringify converts to string

// ✅ Solution: Use date-fns for formatting
import { format, parseISO } from "date-fns";

// Store as ISO string
const data = { date: new Date().toISOString() };

// Display formatted
const formatted = format(parseISO(data.date), "MMM yyyy");
```

